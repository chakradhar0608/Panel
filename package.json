{
  "name": "nccamp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "db"
  ],
  "overrides": {
    "next": "14.2.35"
  },
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');fs.rmSync('node_modules/.cache',{recursive:true,force:true})\"",
    "dev": "cd apps/main && next dev -p 3000",
    "build": "turbo run build",
    "start:main": "set -a && . ./.env.production && set +a && npm run start -w @nccamp/main",
    "db:check": "cd packages/db && node -e \"require('./src').sequelize.authenticate().then(()=>{console.log('DB OK')}).catch((e)=>{console.error(e);process.exit(1)})\"",
    "api:check": "bash scripts/check-apis.sh"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "mysql2": "^3.19.1",
    "framer-motion": "^11.18.2",
    "sequelize": "^6.37.8",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "jsonwebtoken": "^9.0.2",
    "next-auth": "5.0.0-beta.25",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "npm@10.9.0"
}